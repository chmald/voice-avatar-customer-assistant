1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=foundry;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="980" y="720" width="620" height="110" as="geometry"/></mxCell><mxCell id="no4" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#A4262C;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="q4" target="f4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nol4" value="No" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#A4262C;fontSize=11;align=center;verticalAlign=middle;spacingLeft=2;spacingRight=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="912" y="764" width="36" height="22" as="geometry"/></mxCell><mxCell id="ok" value='&lt;b style="font-size:13px"&gt;Healthy&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Run the docs/04-testing.md matrix&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=speech;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="500" y="870" width="380" height="80" as="geometry"/></mxCell><mxCell id="yes4" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="q4" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="yesl4" valu