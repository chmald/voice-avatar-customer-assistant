rent="1"><mxGeometry x="116" y="963" width="34" height="16" as="geometry"/></mxCell><mxCell id="legend_xm0" value="Failed check: first fix" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="156" y="960" width="154" height="22" as="geometry"/></mxCell><mxCell id="legend_x1" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="324" y="963" width="34" height="16" as="geometry"/></mxCell><mxCell id="legend_xm1" value="All checks pass" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="364" y="960" width="104" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
