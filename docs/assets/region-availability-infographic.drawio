<mxfile host="Electron" version="26.0.0"><diagram id="region-availability-infographic" name="Page-1"><mxGraphModel dx="1600" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="accent1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="880" height="8" as="geometry"/></mxCell><mxCell id="accent2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="880" y="0" width="720" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Regions, models and dates that shape a deployment&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1520" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Snapshot from Microsoft Learn on 2026-10-07 (Speech regions, Voice Live overview, model retirement schedule). Re-check at deployment time." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="26" as="geometry"/></mxCell><mxCell id="footer" value="Azure AI Voice Live API with Avatar  |  v1.1.0  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1520" height="20" as="geometry"/></mxCell><mxCell id="k0" value='&lt;span style="font-size:30px;font-weight:bold;color:#0078D4"&gt;6&lt;/span&gt;&lt;br/&gt;&lt;b style="font-size:14px"&gt;Tier-1 regions for the full feature set&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;eastus2 · westus2 · swedencentral · southeastasia · centralindia · eastus: gpt-realtime-2.1 + real-time avatar + HD voices&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=foundry;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="500" height="176" as="geometry"/></mxCell><mxCell id="k1" value='&lt;span style="font-size:30px;font-weight:bold;color:#5C2D91"&gt;11&lt;/span&gt;&lt;br/&gt;&lt;b style="font-size:14px"&gt;Real-time avatar regions&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Adds southcentralus, westeurope, northeurope, italynorth and francecentral (limited capacity); not all have realtime models&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=users;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="500" height="176" as="geometry"/></mxCell><mxCell id="k1__tag" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1022" y="121" width="28" height="18" as="geometry"/></mxCell><mxCell id="k2" value='&lt;span style="font-size:30px;font-weight:bold;color:#5C2D91"&gt;9&lt;/span&gt;&lt;br/&gt;&lt;b style="font-size:14px"&gt;HD voice regions&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;canadacentral, centralindia, eastus, eastus2, francecentral, southeastasia, swedencentral, westeurope, westus2&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=speech;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="500" height="176" as="geometry"/></mxCell><mxCell id="k2__tag" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1542" y="121" width="28" height="18" as="geometry"/></mxCell><mxCell id="k3" value='&lt;span style="font-size:30px;font-weight:bold;color:#5C2D91"&gt;25&lt;/span&gt;&lt;br/&gt;&lt;b style="font-size:14px"&gt;Voice Live built-in models&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Pro / Standard / Lite pricing tiers across realtime, GPT-4.x, GPT-5.x and Phi; anything else via BYOM&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=foundry-models;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="500" height="176" as="geometry"/></mxCell><mxCell id="k3__tag" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="502" y="321" width="28" height="18" as="geometry"/></mxCell><mxCell id="k4" value='&lt;span style="font-size:30px;font-weight:bold;color:#0078D4"&gt;2026-04-10&lt;/span&gt;&lt;br/&gt;&lt;b style="font-size:14px"&gt;Voice Live API version&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Current WebSocket api-version on Microsoft Learn; the azure-ai-voicelive SDK manages it for this app&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=speech;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="500" height="176" as="geometry"/></mxCell><mxCell id="k4__tag" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1022" y="321" width="28" height="18" as="geometry"/></mxCell><mxCell id="k5" value='&lt;span style="font-size:30px;font-weight:bold;color:#A4262C"&gt;2027-03-02&lt;/span&gt;&lt;br/&gt;&lt;b style="font-size:14px"&gt;gpt-realtime (2025-08-28) retires&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;So the default moved to gpt-realtime-2.1 (GA 2026-07-07, retires 2027-06-25). Re-check before every engagement&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=alerts;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1080" y="330" width="500" height="176" as="geometry"/></mxCell><mxCell id="k5__tag" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1510" y="321" width="60" height="18" as="geometry"/></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="70" height="22" as="geometry"/></mxCell><mxCell id="legend_p0" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="116" y="547" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend_m0" value="Generally available" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="150" y="545" width="129" height="22" as="geometry"/></mxCell><mxCell id="legend_p1" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="293" y="547" width="60" height="18" as="geometry"/></mxCell><mxCell id="legend_m1" value="This pattern's default model choice" style="text;html=1;whiteSpace=wrap;a