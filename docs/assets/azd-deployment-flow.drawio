078D4;fontFamily=Segoe UI;spacingTop=8;iconKey=gear;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="260" height="450" as="geometry"/></mxCell><mxCell id="t1_0" value='&lt;b style="font-size:13px"&gt;azd env new &amp;lt;name&amp;gt;&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;One environment per target&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=dev-console;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="332" y="176" width="236" height="108" as="geometry"/></mxCell><mxCell id="t1_1" value='&lt;b style="font-size:13px"&gt;azd env set&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;AZURE_SUBSCRIPTION_ID · AZURE_TENANT_ID · AZURE_LOCATION&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=gear;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="332" y="302" width="236" height="108" as="geometry"/></mxCell><mxCell id="t1_2" value='&lt;b style="font-size:13px"&gt;azd provision --preview&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;What-if before the first deploy&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=dev-console;ima