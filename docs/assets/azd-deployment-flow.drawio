<mxfile host="Electron" version="26.0.0"><diagram id="azd-deployment-flow" name="Page-1"><mxGraphModel dx="1720" dy="790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="accent1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="946" height="8" as="geometry"/></mxCell><mxCell id="accent2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="946" y="0" width="774" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;azd up: from an empty subscription to a running app&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1640" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="One command over the same Bicep that deploy.ps1 uses. The hooks refuse to run against the wrong tenant or subscription." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1640" height="26" as="geometry"/></mxCell><mxCell id="footer" value="Azure AI Voice Live API with Avatar  |  v1.1.0  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1640" height="20" as="geometry"/></mxCell><mxCell id="p0" valu