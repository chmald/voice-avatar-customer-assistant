<mxfile host="Electron" version="26.0.0"><diagram id="configuration-flow" name="Page-1"><mxGraphModel dx="1720" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="accent1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="946" height="8" as="geometry"/></mxCell><mxCell id="accent2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="946" y="0" width="774" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Configuration flow: sources → precedence → consumers&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1640" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Every setting has one home. Infrastructure settings flow through azd (or deploy.ps1) into Bicep; runtime settings flow through the environment and .env into config.py." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1640" height="26" as="geometry"/></mxCell><mxCell id="footer" value="Azure AI Voice Live API with Avatar  |  v1.1.0  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1640" height="20" as="geometry"/></mxCell><mxCell id="src" value="Sources" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;fontFamily=Segoe UI;spacingTop=8;iconKey=file;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="440" height="700" as="geometry"/></mxCell><mxCell id="s0" value='&lt;b style="font-size:13px"&gt;azd environment&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;.azure/&amp;lt;env&amp;gt;/.env, set with azd env set&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=dev-console;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="56" y="170" width="408" height="90" as="geometry"/></mxCell><mxCell id="s1" value='&lt;b style="font-size:13px"&gt;infra/azd.parameters.json&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;${VAR=default} substitutions&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=file;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="56" y="276" width="408" height="90" as="geometry"/></mxCell><mxCell id="s2" value='&lt;b style="font-size:13px"&gt;infra/main.parameters(.local).json&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;deploy.ps1 script path&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=powershell;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="56" y="382" width="408" height="90" as="geometry"/></mxCell><mxCell id="s3" value='&lt;b style="font-size:13px"&gt;.env (from .env.example)&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Read by python-dotenv from the repo root&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=gear;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="56" y="488" width="408" height="90" as="geometry"/></mxCell><mxCell id="s4" value='&lt;b style="font-size:13px"&gt;Process environment&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;$env:NAME (pwsh) or export NAME&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=dev-console;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="56" y="594" width="408" height="90" as="geometry"/></mxCell><mxCell id="s5" value='&lt;b style="font-size:13px"&gt;Browser sidebar&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Avatar, style, voice, Enable Avatar (per session)&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=code;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="56" y="700" width="408" height="90" as="geometry"/></mxCell><mxCell id="p1" value='&lt;b style="font-size:14px"&gt;Infrastructure precedence&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;azd env value → else the ${VAR=default} default → else the main.bicep default. Script path: parameters file → main.bicep default.&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=subscription;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="580" y="220" width="520" height="140" as="geometry"/></mxCell><mxCell id="p2" value='&lt;b style="font-size:14px"&gt;App runtime precedence&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Process environment → .env (load_dotenv never overrides a variable that is already set) → config.py default. UI choices apply to the next session.&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=gear;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="580" y="500" width="520" height="140" as="geometry"/></mxCell><mxCell id="dst" value="Consumers" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#5C2D91;fontFamily=Segoe UI;spacingTop=8;iconKey=toolbox;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="480" height="700" as="geometry"/></mxCell><mxCell id="c0" value='&lt;b style="font-size:13px"&gt;azd.bicep → main.bicep&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Foundry resource, RBAC, tags&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=file;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1216" y="170" width="448" height="90" as="geometry"/></mxCell><mxCell id="c1" value='&lt;b style="font-size:13px"&gt;Hooks&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;preprovision guards · postprovision writes&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=powershell;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1216" y="276" width="448" height="90" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b style="font-size:13px"&gt;demo-ids.local.json&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Outputs for people and dry runs (gitignored)&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=file;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1216" y="382" width="448" height="90" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:13px"&gt;config.py Settings&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Read once when the app starts&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=code;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1216" y="488" width="448" height="90" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:13px"&gt;session_handlers/cloud.py&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Model, BYOM, avatar, voice, tools&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=speech;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1216" y="594" width="448" height="90" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:13px"&gt;session_handlers/local.py&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Local STT / LLM / TTS endpoints, VAD&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#