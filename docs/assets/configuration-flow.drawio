><mxPoint x="1150" y="570"/><mxPoint x="1150" y="533"/></Array></mxGeometry></mxCell><mxCell id="ec4" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es5" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=2;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s5" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="745"/><mxPoint x="1170" y="707.5"/></Array></mxGeometry></mxCell><mxCell id="es5l" value="per session, over the WebSocket" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#0078D4;fontSize=11;align=center;verticalAlign=middle;spacingLeft=2;spacingRight=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="735" y="734" width="210" height="22" as="geometry"/></mxCell><mxCell id="ec5" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="howto" value="&lt;b&gt;Secrets are never configuration.&lt;/b&gt; The app gets an Entra token at runtime; only the optional Speech containers need the resource key, passed as SPEECH_API_KEY at docker compose time. postprovision writes AZURE_AI_ENDPOINT into .env for you." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.5;dashed=1;fontColor=#323130;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1100" height="76" as="geometry"/></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1160" y="866" width="70" height="22" as="geometry"/></mxCell><mxCell id="legend_x0" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1236" y="869" width="34" height="16" as="geometry"/></mxCell><mxCell id="legend_xm0" value="Infrastructure" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1276" y="866" width="98" height="22" as="geometry"/></mxCell><mxCell id="legend_x1" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1388" y="869" width="34" height="16" as="geometry"/></mxCell><mxCell id="legend_xm1" value="Runtime" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1428" y="866" width="54" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
