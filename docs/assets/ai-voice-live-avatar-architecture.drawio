le;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="70" height="22" as="geometry"/></mxCell><mxCell id="legend_p0" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="116" y="662" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend_m0" value="Generally available" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="198" y="660" width="160" height="22" as="geometry"/></mxCell><mxCell id="legend_p1" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="116" y="690" width="60" height="18" as="geometry"/></mxCell><mxCell id="legend_m1" value="On by default" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="198" y="688" width="160" height="22" as="geometry"/></mxCell><mxCell id="legend_p2" value="OPT-IN" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="116" y="718" width="54" height="18" as="geometry"/></mxCell><mxCell id="legend_m2" value="Enabled by a setting" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="198" y="716" width="160" height="22" as="geometry"/></mxCell><mxCell id="legend_p3" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="116" y="746" width="67" height="18" as="geometry"/></mxCell><mxCell id="legend_m3" value="Demo extra" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="198" y="744" width="160" height="22" as="geometry"/></mxCell><mxCell id="lg_dash" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;dashed=1;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="116" y="777" width="34" height="16" as="geometry"/></mxCell><mxCell id="lg_dash_t" value="Fallback / optional path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="198" y="774" width="160" height="22" as="geometry"/></mxCell><mxCell id="howto" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br/&gt;Cloud mode (purple) is the default: one WebSocket from the app to Voice Live, which fuses recognition, the realtime model and voice output, and streams the avatar to the browser over WebRTC. The orange path is opt-in and voice-only: it runs only when ENABLE_LOCAL_FALLBACK=true and the supervisor reports the cloud unreachable (or local mode is forced)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.5;dashed=1;fontColor=#323130;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="816" width="320" height="214" as="geometry"/></mxCell><mxCell id="steps" value="&lt;b&gt;Numbered paths&lt;/b&gt;&lt;br/&gt;&lt;b&gt;1&lt;/b&gt; Browser ↔ app: WebSocket JSON events + base64 PCM16 audio&lt;br/&gt;&lt;b&gt;2&lt;/b&gt; App ↔ Voice Live: WebSocket via the SDK, Entra bearer token&lt;br/&gt;&lt;b&gt;3&lt;/b&gt; Avatar → browser: WebRTC media; the app relays ICE servers and SDP&lt;br/&gt;&lt;b&gt;4&lt;/b&gt; Supervisor → Voice Live endpoint: periodic HTTPS reachability probe&lt;br/&gt;&lt;b&gt;5&lt;/b&gt; Local handler → edge host: STT REST, /v1/chat/completions, SSML (loopback)&lt;br/&gt;&lt;b&gt;6&lt;/b&gt; get_weather → Open-Meteo over HTTPS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201F1E;fontSize=12;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1400" y="790" width="460" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
