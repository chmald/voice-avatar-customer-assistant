portal: create the resources" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#5C2D91;fontFamily=Segoe UI;spacingTop=8;iconKey=foundry;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1640" height="200" as="geometry"/></mxCell><mxCell id="pB" value="Azure portal: access and endpoint" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F1FA;strokeColor=#8764B8;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#8764B8;fontFamily=Segoe UI;spacingTop=8;iconKey=entra-roles;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="820" height="200" as="geometry"/></mxCell><mxCell id="pC" value="Workstation" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;fontFamily=Segoe UI;spacingTop=8;iconKey=dev-console;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="880" y="360" width="800" height="200" as="geometry"/></mxCell><mxCell id="s0" value='&lt;b style="font-size:13px"&gt;Sign in to the right tenant&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Portal: Settings → Directories · CLI: az login --tenant&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=entra-id;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="56" y="170" width="380" height="110" as="geometry"/></mxCell><mxCell id="n0" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#8764B8;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="46" y="158" width="24" height="24" as="geometry"/></mxCell><mxCell id="s1" value='&lt;b style="font-size:13px"&gt;Create the resource group&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Resource groups → Create · Tier-1 region&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=resource-group;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="466" y="170" width="380" height="110" as="geometry"/></mxCell><mxCell id="n1" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="456" y="158" width="24" height="24" as="geometry"/></mxCell><mxCell id="s2" value='&lt;b style="font-size:13px"&gt;Create the Foundry resource&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Kind AIServices · S0 · custom domain = resource name&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=foundry;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="876" y="170" width="380" height="110" as="geometry"/></mxCell><mxCell id="n2" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="866" y="158" width="24" height="24" as="geometry"/></mxCell><mxCell id="s3" value='&lt;b style="font-size:13px"&gt;Turn on system identity&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Resource → Identity → System assigned: On&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=managed-identity;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1286" y="170" width="380" height="110" as="geometry"/></mxCell><mxCell id="s3__tag0" value="OPT-IN" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1602" y="161" width="54" height="18" as="geometry"/></mxCell><mxCell id="n3" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1276" y="158" width="24" height="24" as="geometry"/></mxCell><mxCell id="s4" value='&lt;b style="font-size:13px"&gt;Assign two roles&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Access control (IAM): Cognitive Services User + Foundry User&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=entra-roles;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="56" y="410" width="380" height="110" as="geometry"/></mxCell><mxCell id="n4" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#8764B8;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="46" y="398" width="24" height="24" as="geometry"/></mxCell><mxCell id="s5" value='&lt;b style="font-size:13px"&gt;Copy the endpoint&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;https://&amp;lt;name&amp;gt;.services.ai.azure.com&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=file;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="466" y="410" width="380" height="110" as="geometry"/></mxCell><mxCell id="n5" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#8764B8;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="456" y="398" width="24" height="24" as="geometry"/></mxCell><mxCell id="s6" value='&lt;b style="font-size:13px"&gt;Configure .env&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;AZURE_AI_ENDPOINT · VOICE_LIVE_MODEL&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=gear;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;sp