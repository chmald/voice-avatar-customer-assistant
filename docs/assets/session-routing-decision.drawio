<mxfile host="Electron" version="26.0.0"><diagram id="session-routing-decision" name="Page-1"><mxGraphModel dx="1500" dy="1090" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="accent1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="825" height="8" as="geometry"/></mxCell><mxCell id="accent2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=none;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="825" y="0" width="675" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Which handler serves a new session?&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1420" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="app.py decides once per session (_decide_local). There is no mid-session failover: a running session stays on the handler it started with." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1420" height="26" as="geometry"/></mxCell><mxCell id="footer" value="Azure AI Voice Live API with Avatar  |  v1.1.0  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1420" height="20" as="geometry"/></mxCell><mxCell id="start" value='&lt;b style="font-size:14px"&gt;start_session&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Browser opens a session&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=code;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="600" y="118" width="300" height="70" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;ENABLE_LOCAL_FALLBACK&lt;/b&gt;&lt;br/&gt;= true?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="575" y="228" width="350" height="110" as="geometry"/></mxCell><mxCell id="d2" value="Client asked for local,&lt;br/&gt;or &lt;b&gt;FORCE_LOCAL_MODE&lt;/b&gt; = true?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="575" y="388" width="350" height="110" as="geometry"/></mxCell><mxCell id="d3" value="Supervisor says the&lt;br/&gt;&lt;b&gt;cloud is reachable&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="575" y="548" width="350" height="110" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;Local config complete?&lt;/b&gt;&lt;br/&gt;validate_local_fallback()" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontColor=#201F1E;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="575" y="708" width="350" height="110" as="geometry"/></mxCell><mxCell id="cloud" value='&lt;b style="font-size:14px"&gt;Cloud session (Voice Live)&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Avatar + HD voices · CLOUD badge&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=speech;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="110" y="550" width="370" height="100" as="geometry"/></mxCell><mxCell id="cloud__tag0" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="410" y="541" width="60" height="18" as="geometry"/></mxCell><mxCell id="local" value='&lt;b style="font-size:14px"&gt;Local session (edge host)&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;STT → Foundry Local → NTTS · LOCAL badge + mode_notice&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=foundry;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="565" y="880" width="370" height="100" as="geometry"/></mxCell><mxCell id="local__tag0" value="OPT-IN" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="871" y="871" width="54" height="18" as="geometry"/>