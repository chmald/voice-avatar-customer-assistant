Width=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="d3" target="cloud"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y3l" value="Yes" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#5C2D91;fontSize=11;align=center;verticalAlign=middle;spacingLeft=2;spacingRight=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="508" y="592" width="40" height="22" as="geometry"/></mxCell><mxCell id="n3" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#CA5010;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n3l" value="No: cloud-unreachable" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#CA5010;fontSize=11;align=center;verticalAlign=middle;spacingLeft=2;spacingRight=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="585" y="673" width="150" height="22" as="geometry"/></mxCell><mxCell id="y4" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#CA5010;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="d4" target="local"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y4l" value="Yes" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#CA5010;fontSize=11;align=center;verticalAlign=middle;spacingLeft=2;spacingRight=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="765" y="839" width="40" height="22" as="geometry"/></mxCell><mxCell id="n4" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#A4262C;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="d4" target="err"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1245" y="763"/></Array></mxGeometry></mxCell><mxCell id="n4l" value="No" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#A4262C;fontSize=11;align=center;verticalAlign=middle;spacingLeft=2;spacingRight=2;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1132" y="752" width="36" height="22" as="geometry"/></mxCell><mxCell id="howto" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br/&gt;Diamonds are evaluated top to bottom for every new session. The supervisor runs only when ENABLE_LOCAL_FALLBACK=true and AZURE_AI_ENDPOINT is set. It probes the endpoint every FAILOVER_PROBE_INTERVAL_S (15 s) and reports unreachable after FAILOVER_FAILURE_THRESHOLD (2) consecutive failures, so an outage is detected in about 30 s." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.5;dashed=1;fontColor=#323130;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1050" y="118" width="400" height="170" as="geometry"/></mxCell><mxCell id="tip" value="&lt;b&gt;Check it live&lt;/b&gt;&lt;br/&gt;GET /api/hybrid/status shows enableLocalFallback, forceLocalMode, supervisor.reachable and missingLocalConfig." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.5;dashed=1;fontColor=#323130;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="480" height="80" as="geometry"/></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="70" height="22" as="geometry"/></mxCell><mxCell id="legend_p0" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="116" y="1022" width="60" height="18" as="geometry"/></mxCell><mxCell id="legend_m0" value="Default path" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="182" y="1020" width="85" height="22" as="geometry"/></mxCell><mxCell id="legend_p1" value="OPT-IN" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="281" y="1022" width="54" height="18" as="geometry"/></mxCell><mxCell id="legend_m1" value="Hybrid path (ENABLE_LOCAL_FALLBACK=true)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="341" y="1020" width="262" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
