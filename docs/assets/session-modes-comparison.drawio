width="608" height="66" as="geometry"/></mxCell><mxCell id="l2" value='&lt;b style="font-size:13px"&gt;Speech to text container&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;REST on :5001, one locale per image&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=speech;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="976" y="328" width="608" height="66" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Reasoning&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=none;fontColor=#201F1E;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="220" height="66" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:13px"&gt;gpt-realtime-2.1 (built-in) or BYOM&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Speech-in / speech-out realtime model&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=foundry-models;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="296" y="404" width="608" height="66" as="geometry"/></mxCell><mxCell id="l3" value='&lt;b style="font-size:13px"&gt;Foundry Local chat completion&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;qwen2.5-7b-instruct default · phi-4&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=foundry;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="976" y="404" width="608" height="66" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Speech output&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=none;fontColor=#201F1E;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="220" height="66" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:13px"&gt;HD, Multilingual and Standard voices&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Voice chosen per session in the UI&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=speech;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="296" y="480" width="608" height="66" as="geometry"/></mxCell><mxCell id="l4" value='&lt;b style="font-size:13px"&gt;Neural TTS container&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Standard neural voice only, one per image&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=speech;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="976" y="480" width="608" height="66" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;Avatar&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=none;fontColor=#201F1E;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="556" width="220" height="66" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:13px"&gt;Real-time avatar over WebRTC&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Video and photo avatars&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=users;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="296" y="556" width="608" height="66" as="geometry"/></mxCell><mxCell id="l5" value='&lt;b style="font-size:13px"&gt;No avatar&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Voice-only by design: no on-prem avatar exists&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=users;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="976" y="556" width="608" height="66" as="geometry"/></mxCell><mxCell id="r6" value="&lt;b&gt;Tools&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=none;fontColor=#201F1E;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="220" height="66" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:13px"&gt;Function calling (get_weather)&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;tool_choice=auto when enabled&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=toolbox;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="296" y="632" width="608" height="66" as="geometry"/></mxCell><mxCell id="l6" value='&lt;b style="font-size:13px"&gt;No function calling in the MVP&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Planned for a later version&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=toolbox;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="976" y="632" width="608" height="66" as="geometry"/></mxCell><mxCell id="r7" value="&lt;b&gt;First audio out&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=none;fontColor=#201F1E;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="220" height="66" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:13px"&gt;About 0.5 to 1.0 s&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Indicative, link-dependent&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=gear;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="296" y="708" width="608" height="66" as="geometry"/></mxCell><mxCell id="l7" value='&lt;b style="font-size:13px"&gt;About 2 to 4 s&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Indicative, GPU-dependent&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=gear;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="976" y="708" width="608" height="66" as="geometry"/></mxCell><mxCell id="r8" value="&lt;b&gt;Network egress&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=none;fontColor=#201F1E;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="784" width="220" height="66" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:13px"&gt;Continuous to *.services.ai.azure.com&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Inference scope follows the model&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=virtual-network;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="296" y="784" width="608" height="66" as="geometry"/></mxCell><mxCell id="l8" value='&lt;b style="font-size:13px"&gt;None during the session&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Connected metering pings in the background&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=virtual-network;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="976" y="784" width="608" height="66" as="geometry"/></mxCell><mxCell id="reco" value="&lt;b&gt;Recommendation:&lt;/b&gt; run cloud mode as the default experience. Turn on local fallback only for sites with unreliable connectivity; it keeps a voice conversation alive during an outage, not the avatar experience." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontColor=#201F1E;fontSize=13;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1560" height="70" as="geometry"/></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="70" height="22" as="geometry"/></mxCell><mxCell id="legend_p0" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="116" y="992" width="60" height="18" as="geometry"/></mxCell><mxCell id="legend_m0" value="Default experience" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="182" y="990" width="123" height="22" as="geometry"/></mxCell><mxCell id="legend_p1" value="OPT-IN" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="319" y="992" width="54" height="18" as="geometry"/></mxCell><mxCell id="legend_m1" value="Needs ENABLE_LOCAL_FALLBACK=true" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="379" y="990" width="211" height="22" as="geometry"/></mxCell><mxCell id="legend_x0" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontColor=#201F1E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="604" y="993" width="34" height="16" as="geometry"/></mxCell><mxCell id="legend_xm0" value="Capability differs between modes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="644" y="990" width="211" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
