 y="176" width="220" height="66" as="geometry"/></mxCell><mxCell id="c0" value='&lt;b style="font-size:13px"&gt;Browser AudioWorklet, PCM16 24 kHz&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Same WebSocket protocol&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=gear;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="296" y="176" width="608" height="66" as="geometry"/></mxCell><mxCell id="l0" value='&lt;b style="font-size:13px"&gt;Browser AudioWorklet, PCM16 24 kHz&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Same WebSocket protocol&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;iconKey=gear;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="976" y="176" width="608" height="66" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Turn detection&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=none;fontColor=#201F1E;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="220" height="66" as="geometry"/></mxCell><mxCell id="c1" value='&lt;b style="font-size:13px"&gt;Azure semantic VAD + barge-in&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:11px;color:#605E5C"&gt;Server-side, noise suppression + echo cancel&lt;/span&gt;' style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fill