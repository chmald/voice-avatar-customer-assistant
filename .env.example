# Azure AI Foundry / Voice Live API
# Required: your Microsoft Foundry resource endpoint
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com

# Built-in Voice Live model. Pick one of:
#   gpt-realtime              (GA, default)
#   gpt-realtime-1.5          (GA — longer context, better instruction-following)
#   gpt-realtime-2            (preview — latest, configurable reasoning effort)
#   gpt-realtime-mini         (GA — cost-optimized)
#   gpt-4o-realtime-preview        (legacy)
#   gpt-4o-mini-realtime-preview   (legacy)
# For private / fine-tuned deployments use ENABLE_BYOM_MODE=true with VOICE_BYOM_MODE=byom-azure-openai-realtime.
# Reference: docs/hybrid/08-model-selection.md
VOICE_LIVE_MODEL=gpt-realtime

# Bring Your Own Model (BYOM): use a custom deployment in your Foundry resource.
# Docs: https://learn.microsoft.com/azure/ai-services/speech-service/how-to-bring-your-own-model
# When ENABLE_BYOM_MODE=true, VOICE_BYOM_MODEL is sent as the `model` query param
# (it must be the deployment NAME from your Foundry portal, not the underlying model id).
ENABLE_BYOM_MODE=false
# Profile: byom-azure-openai-realtime | byom-azure-openai-chat-completion | byom-foundry-anthropic-messages
VOICE_BYOM_MODE=byom-azure-openai-realtime
# Your Foundry deployment name (e.g. "gpt-realtime-1.5" if that's what you named the deployment)
VOICE_BYOM_MODEL=
# Optional: target a deployment in a DIFFERENT Foundry resource. Resource name only, no domain.
# Example: if endpoint is https://my-other-foundry.services.ai.azure.com, set this to "my-other-foundry".
VOICE_BYOM_FOUNDRY_RESOURCE_OVERRIDE=

# Server port (default: 8000)
PORT=8000

# Enable the get_weather function tool (default: false).
# When true, the model can call Open-Meteo (keyless) to answer weather questions,
# including "near me" lookups using the browser's geolocation coordinates.
ENABLE_WEATHER_TOOL=false

# ─── Hybrid local fallback (Approach A — see docs/hybrid/) ──────────────────
# When true, if the cloud Voice Live endpoint is unreachable at the start of a
# session, the app routes that session to a fully local STT/LLM/TTS pipeline
# (voice-only, no avatar, no HD voices). Cloud is still the default whenever
# it's reachable.
ENABLE_LOCAL_FALLBACK=false

# Force every session to use local mode even when cloud is reachable
# (useful for offline development, training, and demo recording).
FORCE_LOCAL_MODE=false

# Local Speech-to-Text container (Azure `speech-to-text` Docker image).
LOCAL_STT_ENDPOINT=http://localhost:5001
LOCAL_STT_LANGUAGE=en-US

# Local Neural Text-to-Speech container (Azure `neural-text-to-speech` image).
LOCAL_TTS_ENDPOINT=http://localhost:5002
# Voice short-name must match the container tag you pulled, e.g.
# `en-us-jennyneural` ⇒ en-US-JennyNeural. HD/Dragon voices are NOT available
# in the container — pick a standard neural voice.
LOCAL_TTS_VOICE=en-US-JennyNeural

# Local LLM via Microsoft Foundry Local (OpenAI-compatible chat completions).
# Foundry Local listens on a dynamic port; the OpenAI-compatible base ends in /v1.
LOCAL_LLM_ENDPOINT=http://localhost:5273/v1
LOCAL_LLM_MODEL=qwen2.5-7b-instruct
# Foundry Local doesn't authenticate, but the OpenAI client demands a key field.
LOCAL_LLM_API_KEY=not-needed
LOCAL_LLM_TIMEOUT_S=30
LOCAL_LLM_MAX_TOKENS=256

# Connectivity supervisor — probes the cloud Voice Live REST surface.
FAILOVER_PROBE_INTERVAL_S=15
FAILOVER_PROBE_TIMEOUT_S=3
FAILOVER_FAILURE_THRESHOLD=2

# Energy-based VAD (local mode only — semantic VAD requires Voice Live).
LOCAL_VAD_SILENCE_MS=700
LOCAL_VAD_RMS_THRESHOLD=350
LOCAL_VAD_MIN_SPEECH_MS=250
LOCAL_VAD_MAX_UTTERANCE_MS=20000

# Authentication: uses DefaultAzureCredential (Azure CLI / managed identity).
# Run: az login
# Required roles: Cognitive Services User + Azure AI User
